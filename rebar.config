{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{cowboy, "2.19.0"}, {jsx, "3.1.0"}]}.
{eunit_opts, [verbose]}.
{shell, [{apps, [beamvoice]}]}.
{relx, [{release, {beamvoice, "0.1.0"}, [beamvoice]},
        {dev_mode, false},
        {include_erts, true},
        {extended_start_script, true}]}.
